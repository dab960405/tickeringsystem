# Copia este archivo a .env y ajusta los valores. Nunca subas .env al repositorio.
# Los valores de ejemplo solo sirven para desarrollo local.

# Perfil de Spring activo: dev, test o prod
SPRING_PROFILES_ACTIVE=dev

# --- PostgreSQL (fuente de verdad de ticketing-api) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ticketing
POSTGRES_USER=ticketing
POSTGRES_PASSWORD=change-me-postgres

# --- Redis (caché, TTL de reservas, rate limiting, refresh tokens) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis

# --- Kafka (modo KRaft) ---
# Dirección que usan las aplicaciones ejecutadas desde el host (IDE)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Puerto publicado en el host para el listener externo
KAFKA_HOST_PORT=9092
# Identificador del clúster KRaft (cualquier UUID en base64; se genera con kafka-storage.sh random-uuid)
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# --- MongoDB (solo notification-service) ---
MONGO_ROOT_USERNAME=notification
MONGO_ROOT_PASSWORD=change-me-mongo
MONGO_PORT=27017
MONGODB_URI=mongodb://notification:change-me-mongo@localhost:27017/notifications?authSource=admin

# --- Seguridad ---
# Secreto HS256 de al menos 256 bits (32 bytes). Genera uno con: openssl rand -base64 32
JWT_SECRET=replace-with-output-of-openssl-rand-base64-32
# Duración del access token en minutos
JWT_ACCESS_TTL_MINUTES=15
# Duración del refresh token en días
JWT_REFRESH_TTL_DAYS=7
# Máximo de intentos de login por IP y email dentro de la ventana fija
LOGIN_MAX_ATTEMPTS=5
# Duración de la ventana de rate limiting en segundos
LOGIN_WINDOW_SECONDS=60
# Secreto HMAC-SHA256 que firma el webhook de pago simulado (header X-Signature)
PAYMENT_WEBHOOK_SECRET=replace-with-output-of-openssl-rand-base64-32
# API key para consultar GET /notifications (header X-Api-Key)
NOTIFICATION_API_KEY=replace-with-a-random-api-key
# Orígenes permitidos por CORS, separados por comas
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Reglas de negocio ---
# Minutos que dura una reserva temporal antes de expirar
RESERVATION_TTL_MINUTES=10
# Ventana máxima para recuperar una reserva expirada tras una captura tardía
RESERVATION_RECOVERY_GRACE=15m

# --- Procesamiento de eventos del proveedor (ADR-018/ADR-019) ---
# Timeouts de transacción en segundos enteros; TX-APPLY nunca puede superar 5s
OPERATION_TX_RX_TIMEOUT=3s
OPERATION_TX_CLAIM_TIMEOUT=3s
OPERATION_TX_APPLY_TIMEOUT=5s
OPERATION_TX_PROJECT_TIMEOUT=3s
# lock_timeout de PostgreSQL; debe ser menor que cualquier timeout de transacción
OPERATION_LOCK_TIMEOUT=1s
# Duración del lease de un worker; debe superar TX-APPLY y no exceder 10m
OPERATION_LEASE_DURATION=30s
# Jobs por ciclo de recuperación (1-100)
OPERATION_BATCH_SIZE=50
# Intentos máximos por job (1-10) y espera entre reintentos
OPERATION_MAX_ATTEMPTS=3
OPERATION_RETRY_BACKOFF=5s
# Frecuencia del worker de recuperación y su activación
OPERATION_RECOVERY_INTERVAL=1s
OPERATION_RECOVERY_ENABLED=true
# Identidad del proveedor simulado
PAYMENT_PROVIDER_CODE=SIMULATED
PAYMENT_MERCHANT_ACCOUNT_ID=default
PAYMENT_IDENTITY_NAMESPACE=payments.v1

# --- Puertos de las aplicaciones ---
TICKETING_API_PORT=8080
NOTIFICATION_SERVICE_PORT=8081

# --- Observabilidad ---
GRAFANA_ADMIN_PASSWORD=change-me-grafana
