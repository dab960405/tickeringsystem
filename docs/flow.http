# This workflow is a manual example and is not executed in CI.
# Requires the VS Code REST Client extension.
# Prerequisite: configure a PUBLISHED event with a ticket type whose sale window is open
# and whose inventory is available. Replace eventId and ticketTypeId with real UUIDs.
# Send the requests in order. Copy accessToken and refreshToken from the login response.
# Keep the access token for protected requests and perform logout last.

@baseUrl = http://localhost:8080
@email = smoke.user@example.com
@password = ChangeMe123
@fullName = Smoke Test User
@accessToken = REPLACE_WITH_ACCESS_TOKEN
@refreshToken = REPLACE_WITH_REFRESH_TOKEN
@eventId = REPLACE_WITH_PUBLISHED_EVENT_UUID
@ticketTypeId = REPLACE_WITH_TICKET_TYPE_UUID
@reservationId = REPLACE_WITH_RESERVATION_UUID
@orderId = REPLACE_WITH_ORDER_UUID
@orderAmount = REPLACE_WITH_ORDER_TOTAL_AMOUNT
@orderCurrency = REPLACE_WITH_ORDER_CURRENCY
@webhookSignature = REPLACE_WITH_HMAC_SHA256_HEX

### 1. Register
POST {{baseUrl}}/api/v1/auth/register
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}",
  "fullName": "{{fullName}}"
}

### 2. Sign in
# Copy accessToken and refreshToken from the response and update the variables above.
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

### 3. Read the public event catalog
# Use a published event. The response includes ticketTypes and their IDs.
GET {{baseUrl}}/api/v1/events/{{eventId}}

### 4. Create a reservation
POST {{baseUrl}}/api/v1/reservations
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "ticketTypeId": "{{ticketTypeId}}",
  "quantity": 1
}

### 5. Create an idempotent order
# Copy the reservation ID from the previous response into reservationId.
POST {{baseUrl}}/api/v1/orders
Authorization: Bearer {{accessToken}}
Idempotency-Key: smoke-order-0001
Content-Type: application/json

{
  "reservationId": "{{reservationId}}"
}

### 6. Simulated payment webhook
# Copy id, totalAmount and currency from the order response into orderId, orderAmount and orderCurrency.
# A seeded General ticket costs USD 45.00; always use your actual order's total amount.
# X-Signature must be the lowercase hexadecimal HMAC-SHA256 of the EXACT RAW REQUEST BODY
# (identical bytes, no reformatting). VS Code REST Client does not compute that HMAC.
# Put the exact JSON request body into PAYLOAD and generate the signature with:
# printf '%s' "$PAYLOAD" | openssl dgst -sha256 -hmac "$PAYMENT_WEBHOOK_SECRET"
# Copy the hex digest into @webhookSignature. If the raw body changes, sign it again.
POST {{baseUrl}}/api/v1/payments/webhook
X-Signature: {{webhookSignature}}
Content-Type: application/json

{"orderId":"{{orderId}}","status":"SUCCEEDED","providerReference":"smoke-provider-0001","providerEventId":"8f0d3f3d-8a0c-4f1d-a42a-b0f0a55f1001","providerOperationId":"smoke-operation-0001","operationKind":"PAYMENT_CAPTURE","amount":{{orderAmount}},"currency":"{{orderCurrency}}"}

### 7. Refresh access
POST {{baseUrl}}/api/v1/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

### 8. Logout (last step)
# Revoke the refresh token. Do not send this request before the protected operations.
POST {{baseUrl}}/api/v1/auth/logout
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}
